# =============================================================
# IWILLTRAVEL — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — NEVER commit real secrets.
# =============================================================

# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI Orchestration (required) ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Travel Intelligence APIs (Research & Disruption) ─────────
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
AVIATIONSTACK_API_KEY=your-aviationstack-api-key
AVIATIONSTACK_WEBHOOK_SECRET=your-webhook-signing-secret
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ── Financials & Location ────────────────────────────────────
FIXER_API_KEY=your-fixer-api-key
GEOAPIFY_API_KEY=your-geoapify-api-key
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=your-google-maps-embed-key

# ── Analytics & Comms ────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
VITE_CLARITY_ID=your-clarity-id
