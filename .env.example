# =============================================================
# IWILLTRAVEL — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — NEVER commit real secrets.
# =============================================================

# ── Supabase (required) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI Orchestration (required) ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Travel Intelligence APIs (Research & Disruption) ─────────
# Amadeus self-service APIs were shut down on 17 July 2026. Leave blank unless you have Enterprise access.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Flight offers and bookings
DUFFEL_TOKEN=duffel_test_your-token

# ── Flight status & alerts ───────────────────────────────────
# AeroDataBox (API.Market or RapidAPI): live flight status, delays, gates, airport boards.
# Flight alerts and airport boards are switched off when this is empty.
AERODATABOX_API_KEY=
# api.market (default) or rapidapi — which marketplace issued the key
AERODATABOX_MARKET=api.market
# Shared secret checked on /api/webhooks/aerodatabox (webhook is rejected when empty)
AERODATABOX_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Contact URL sent in the User-Agent to Planespotters (their API requires one)
PLANESPOTTERS_CONTACT_URL=https://your-domain.com/contact

# ── Financials & Location ────────────────────────────────────
FIXER_API_KEY=your-fixer-api-key
GEOAPIFY_API_KEY=your-geoapify-api-key
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=your-google-maps-embed-key

# ── Payments (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Abuse protection ─────────────────────────────────────────
# Random string used to hash visitor IPs for guest daily limits
GUEST_IP_SALT=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-a-long-random-string
# Telegram bot (token from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Pass the same value as secret_token when calling Telegram setWebhook
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Traveller emails (Resend) ────────────────────────────────
# Verified sender on your Resend domain, e.g. "iWillTravel <trips@yourdomain.com>"
EMAIL_FROM=iWillTravel <trips@your-domain.com>
# Random string used to sign unsubscribe links (automated emails are not sent without it)
EMAIL_SIGNING_SECRET=change-me-to-a-long-random-string

# ── SEO ──────────────────────────────────────────────────────
# Optional: random 32+ char key; new guides are pinged to Bing/Yandex via IndexNow
INDEXNOW_KEY=

# ── Analytics & Comms ────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
VITE_CLARITY_ID=your-clarity-id
